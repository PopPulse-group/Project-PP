syntax = "v1"

info (
	title:   "生鲜零售平台 MVP API"
	desc:    "生鲜即时零售平台后端 MVP 接口契约 v1（两周计划书口径）"
	author:  "PopPulse-group"
	version: "v1.0"
)

// ============ 通用类型 ============
type (
	PageReq {
		Page     int `form:"page,default=1"`
		PageSize int `form:"page_size,default=20"`
	}
)

// ============ 健康检查 ============
type HealthResp {
	Status string `json:"status"`
	Time   string `json:"time"`
}

// ============ 账号 ============
type (
	RegisterReq {
		Username string `json:"username"` // 4-32 字符
		Password string `json:"password"` // 8-64 字符
		Nickname string `json:"nickname,optional"`
	}
	LoginReq {
		Username string `json:"username"`
		Password string `json:"password"`
	}
	UserInfo {
		Id        string `json:"id"`
		Username  string `json:"username"`
		Nickname  string `json:"nickname"`
		CreatedAt string `json:"created_at"`
	}
	LoginResp {
		AccessToken string   `json:"access_token"`
		ExpiresAt   int64    `json:"expires_at"` // Unix 秒
		User        UserInfo `json:"user"`
	}
)

// ============ 地址 ============
type (
	AddressItem {
		Id          string `json:"id"`
		ContactName string `json:"contact_name"`
		Mobile      string `json:"mobile"`
		Province    string `json:"province"`
		City        string `json:"city"`
		Detail      string `json:"detail"`
		IsDefault   bool   `json:"is_default"`
		CreatedAt   string `json:"created_at"`
	}
	AddressListResp {
		List []AddressItem `json:"list"`
	}
	CreateAddressReq {
		ContactName string `json:"contact_name"`
		Mobile      string `json:"mobile"`
		Province    string `json:"province"`
		City        string `json:"city"`
		Detail      string `json:"detail"`
		IsDefault   bool   `json:"is_default,optional"`
	}
	AddressIdReq {
		AddressId string `path:"address_id"`
	}
)

// ============ 商品 ============
type (
	CategoryItem {
		Id     string `json:"id"`
		Name   string `json:"name"`
		SortNo int64  `json:"sort_no"`
	}
	CategoryListResp {
		List []CategoryItem `json:"list"`
	}
	ProductItem {
		Id          string `json:"id"`
		CategoryId  string `json:"category_id"`
		Name        string `json:"name"`
		Description string `json:"description"`
		Unit        string `json:"unit"` // 如 500g/份、盒
		Price       int64  `json:"price"` // 整数分
		Stock       int64  `json:"stock"` // 可售库存
		Status      string `json:"status"`
		CreatedAt   string `json:"created_at"`
	}
	ProductListReq {
		CategoryId string `form:"category_id,optional"`
		Keyword    string `form:"keyword,optional"`
		PageReq
	}
	ProductListResp {
		List  []ProductItem `json:"list"`
		Total int64         `json:"total"`
	}
	ProductDetailReq {
		ProductId string `path:"product_id"`
	}
	ProductDetailResp {
		Product ProductItem `json:"product"`
	}
)

// ============ 购物车 ============
type (
	CartItem {
		Id            string `json:"id"`
		ProductId     string `json:"product_id"`
		ProductName   string `json:"product_name"`
		Unit          string `json:"unit"`
		Price         int64  `json:"price"` // 实时单价，整数分
		Quantity      int64  `json:"quantity"`
		Amount        int64  `json:"amount"` // price * quantity
		Stock         int64  `json:"stock"`
		ProductStatus string `json:"product_status"`
	}
	CartResp {
		Items       []CartItem `json:"items"`
		TotalAmount int64      `json:"total_amount"`
	}
	AddCartItemReq {
		ProductId string `json:"product_id"`
		Quantity  int64  `json:"quantity"` // 1-99
	}
	CartItemIdReq {
		CartItemId string `path:"cart_item_id"`
	}
	UpdateCartItemReq {
		CartItemId string `path:"cart_item_id"`
		Quantity   int64  `json:"quantity"` // 1-99；0 视为删除
	}
)

// ============ 订单 ============
type (
	OrderItem {
		Id          string `json:"id"`
		Status      string `json:"status"` // pending_payment | paid | delivering | delivered | cancelled
		TotalAmount int64  `json:"total_amount"`
		CreatedAt   string `json:"created_at"`
		PaidAt      string `json:"paid_at,optional"`
	}
	OrderListReq {
		Status string `form:"status,optional"`
		PageReq
	}
	OrderListResp {
		List  []OrderItem `json:"list"`
		Total int64       `json:"total"`
	}
	OrderItemDetail {
		Id          string `json:"id"`
		ProductId   string `json:"product_id"`
		ProductName string `json:"product_name"`
		Unit        string `json:"unit"`
		UnitPrice   int64  `json:"unit_price"` // 下单价快照，整数分
		Quantity    int64  `json:"quantity"`
		Amount      int64  `json:"amount"`
	}
	DeliveryEventItem {
		Id          string `json:"id"`
		EventType   string `json:"event_type"` // paid | sorting | delivering | delivered | timed_out
		Description string `json:"description"`
		OccurredAt  string `json:"occurred_at"`
	}
	OrderDetail {
		Id          string              `json:"id"`
		UserId      string              `json:"user_id"`
		Status      string              `json:"status"`
		TotalAmount int64               `json:"total_amount"`
		Items       []OrderItemDetail   `json:"items"`
		Delivery    []DeliveryEventItem `json:"delivery_events"`
		CreatedAt   string              `json:"created_at"`
		PaidAt      string              `json:"paid_at,optional"`
		ExpireAt    string              `json:"expire_at,optional"`
		CancelledAt string              `json:"cancelled_at,optional"`
		DeliveredAt string              `json:"delivered_at,optional"`
	}
	OrderIdReq {
		OrderId string `path:"order_id"`
	}
	OrderDetailResp {
		Order OrderDetail `json:"order"`
	}
	CreateOrderReq {
		IdempotencyKey string           `header:"Idempotency-Key"` // 16-64 字符，建议 UUID
		Items          []OrderItemInput `json:"items"`
		Remark         string           `json:"remark,optional"`
	}
	OrderItemInput {
		ProductId string `json:"product_id"`
		Quantity  int64  `json:"quantity"` // 1-99
	}
	CreateOrderResp {
		OrderId     string `json:"order_id"`
		TotalAmount int64  `json:"total_amount"`
		Status      string `json:"status"`
		ExpireAt    string `json:"expire_at"`
	}
	CancelOrderResp {
		OrderId string `json:"order_id"`
		Status  string `json:"status"`
	}
	MockPayResp {
		OrderId string `json:"order_id"`
		Status  string `json:"status"` // paid
		PaidAt  string `json:"paid_at"`
	}
	DeliveryResp {
		OrderId string              `json:"order_id"`
		Status  string              `json:"order_status"`
		Events  []DeliveryEventItem `json:"events"`
	}
)

// ============ AI 菜谱推荐 ============
type (
	CreateMealPlanReq {
		PeopleCount int64    `json:"people_count"` // 1-20
		BudgetCents int64    `json:"budget_cents"` // 总预算，整数分
		Tastes      []string `json:"tastes,optional"` // 口味偏好，如 川菜、清淡
		Avoids      []string `json:"avoid,optional"` // 忌口/过敏，如 香菜、花生
	}
	RecipeDish {
		RecipeId string   `json:"recipe_id"`
		Title    string   `json:"title"`
		Cuisine  string   `json:"cuisine,optional"`
		Steps    []string `json:"steps"`
	}
	SkuMatchItem {
		SkuId       string `json:"sku_id"` // 匹配到的在售商品，无匹配为 ""
		ProductName string `json:"product_name"`
		Ingredient  string `json:"ingredient"`
		Quantity    int64  `json:"quantity"`
		UnitPrice   int64  `json:"unit_price"` // 整数分
		Amount      int64  `json:"amount"`
		Available   bool   `json:"available"` // 在售且有库存
	}
	RecipeWithSkus {
		Recipe       RecipeDish     `json:"recipe"`
		Items        []SkuMatchItem `json:"items"`
		TotalAmount  int64          `json:"total_amount"`
		WithinBudget bool           `json:"within_budget"`
	}
	MealPlanResp {
		SessionId   string           `json:"session_id"`
		PeopleCount int64            `json:"people_count"`
		BudgetCents int64            `json:"budget_cents"`
		Recipes     []RecipeWithSkus `json:"recipes"`
		AvoidHint   string           `json:"avoid_hint,optional"`
		Mock        bool             `json:"mock"` // 是否 Mock 生成，演示必须可辨识
	}
	ConfirmMealPlanReq {
		SessionId      string   `json:"session_id"`
		RecipeIds      []string `json:"recipe_ids"` // 选中的菜谱
		IdempotencyKey string   `header:"Idempotency-Key"`
	}
	ConfirmMealPlanResp {
		AddedItems  int64 `json:"added_items"` // 本次新增明细数
		MergedItems int64 `json:"merged_items"` // 合并已有明细数
		TotalAmount int64 `json:"total_amount"`
	}
)

// ============ 路由：公共 ============
@server (
	group:  health
	prefix: /api/v1
)
service fresh {
	@doc "进程存活"
	@handler healthLive
	get /health/live returns (HealthResp)

	@doc "服务就绪（MySQL/Redis）"
	@handler healthReady
	get /health/ready returns (HealthResp)
}

// ============ 路由：账号 ============
@server (
	group:  auth
	prefix: /api/v1
)
service fresh {
	@doc "注册（成功即登录，返回 token）"
	@handler register
	post /auth/register (RegisterReq) returns (LoginResp)

	@doc "登录"
	@handler login
	post /auth/login (LoginReq) returns (LoginResp)
}

// ============ 路由：用户与地址 ============
@server (
	group:  user
	prefix: /api/v1
	jwt:    Auth
)
service fresh {
	@doc "当前用户"
	@handler getUserMe
	get /users/me returns (UserInfo)

	@doc "本人地址列表"
	@handler listAddresses
	get /users/me/addresses returns (AddressListResp)

	@doc "新增地址"
	@handler createAddress
	post /users/me/addresses (CreateAddressReq) returns (AddressItem)

	@doc "删除地址（仅本人）"
	@handler deleteAddress
	delete /users/me/addresses/:address_id (AddressIdReq)
}

// ============ 路由：商品（public） ============
@server (
	group:  product
	prefix: /api/v1
)
service fresh {
	@doc "分类列表"
	@handler listCategories
	get /categories returns (CategoryListResp)

	@doc "商品列表（分类/关键词/分页）"
	@handler listProducts
	get /products (ProductListReq) returns (ProductListResp)

	@doc "商品详情（含可售库存）"
	@handler getProductDetail
	get /products/:product_id (ProductDetailReq) returns (ProductDetailResp)
}

// ============ 路由：购物车 ============
@server (
	group:  cart
	prefix: /api/v1
	jwt:    Auth
)
service fresh {
	@doc "查看购物车（实时价格与库存）"
	@handler getCart
	get /cart returns (CartResp)

	@doc "加购（同商品合并数量）"
	@handler addCartItem
	post /cart/items (AddCartItemReq) returns (CartResp)

	@doc "改数量（0 视为删除）"
	@handler updateCartItem
	patch /cart/items/:cart_item_id (UpdateCartItemReq) returns (CartResp)

	@doc "删除明细"
	@handler deleteCartItem
	delete /cart/items/:cart_item_id (CartItemIdReq) returns (CartResp)
}

// ============ 路由：订单 ============
@server (
	group:  order
	prefix: /api/v1
	jwt:    Auth
)
service fresh {
	@doc "创建订单（服务端计价，Idempotency-Key 必填）"
	@handler createOrder
	post /orders (CreateOrderReq) returns (CreateOrderResp)

	@doc "本人订单列表"
	@handler listOrders
	get /orders (OrderListReq) returns (OrderListResp)

	@doc "本人订单详情"
	@handler getOrderDetail
	get /orders/:order_id (OrderIdReq) returns (OrderDetailResp)

	@doc "取消待支付订单（一次性释放库存）"
	@handler cancelOrder
	post /orders/:order_id/cancel (OrderIdReq) returns (CancelOrderResp)

	@doc "模拟支付（仅 Mock.Enabled 时可用）"
	@handler mockPay
	post /orders/:order_id/mock-pay (OrderIdReq) returns (MockPayResp)

	@doc "查询模拟配送进度"
	@handler getDelivery
	get /orders/:order_id/delivery (OrderIdReq) returns (DeliveryResp)
}

// ============ 路由：AI 菜谱 ============
@server (
	group:  ai
	prefix: /api/v1
	jwt:    Auth
)
service fresh {
	@doc "生成菜谱推荐（人数/预算/口味/忌口 → 结构化菜谱 + 在售 SKU 匹配）"
	@handler createMealPlan
	post /ai/meal-plans (CreateMealPlanReq) returns (MealPlanResp)

	@doc "确认推荐并加入购物车（幂等合并，不直接扣款）"
	@handler confirmMealPlan
	post /ai/meal-plans/confirm (ConfirmMealPlanReq) returns (ConfirmMealPlanResp)
}

